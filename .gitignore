# The real config — secrets and personal identifiers. Never commit.
.env

# Runtime artifacts
*.log
.agent-logs/
backups/

# OS noise
.DS_Store

# Python bytecode (render-tasks.py / bus.py generate these on run)
__pycache__/
*.pyc

# Belt and suspenders: catch any env variant, but keep the template
*.env
!example.env
secrets*
# Editor backups / copies of the secrets file (nano writes ".env.save"). One appeared on
# 2026-10-11 and matched none of the rules above, so the next push would have published it.
.env.*
*.save
